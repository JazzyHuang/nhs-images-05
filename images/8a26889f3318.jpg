    <style>
      .cls-1 {
        opacity: 0;
      }

      .cls-1, .cls-2, .cls-3, .cls-4, .cls-5, .cls-6, .cls-7, .cls-8, .cls-9, .cls-10, .cls-11 {
        fill: none;
      }

      .cls-1, .cls-2, .cls-4, .cls-12, .cls-6, .cls-8, .cls-10 {
        stroke-miterlimit: 10;
      }

      .cls-1, .cls-3, .cls-12, .cls-6, .cls-9, .cls-10 {
        stroke: #000;
      }

      .cls-2, .cls-3, .cls-5, .cls-12, .cls-7, .cls-8, .cls-11 {
        stroke-width: .5px;
      }

      .cls-2, .cls-5, .cls-7, .cls-11 {
        stroke: #888;
      }

      .cls-3, .cls-5, .cls-9, .cls-11 {
        stroke-miterlimit: 500;
      }

      .cls-4, .cls-6, .cls-9, .cls-10 {
        stroke-width: 1.5px;
      }

      .cls-4, .cls-8 {
        stroke: #d5d5d5;
      }

      .cls-13 {
        font-family: ArialMT, Arial;
        font-size: 17px;
      }

      .cls-12 {
        fill: #fff;
      }

      .cls-10, .cls-11 {
        stroke-linecap: square;
      }
    </style>
